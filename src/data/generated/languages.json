,"name":"Inglés","native":"English","family":"Indoeuropea","branch":"Germánica","script":"Latino","speakers":380,"countries":["gb","us","ca","au","nz","ie","za","ng","in","jm","gh","ke","ph","sg","mt"],"phrases":[["Good morning, how are you?","Buenos días, ¿cómo estás?"],["Thank you very much for your help.","Muchas gracias por tu ayuda."],["Where is the train station?","¿Dónde está la estación de tren?"],["I really like travelling.","Me gusta mucho viajar."],["It is very hot today.","Hoy hace mucho calor."]]},{"id":"de","name":"Alemán","native":"Deutsch","family":"Indoeuropea","branch":"Germánica","script":"Latino","speakers":76,"countries":["de","at","ch","li","lu","be"],"phrases":[["Guten Morgen, wie geht es dir?","Buenos días, ¿cómo estás?"],["Vielen Dank für deine Hilfe.","Muchas gracias por tu ayuda."],["Wo ist der Bahnhof?","¿Dónde está la estación?"],["Ich reise sehr gern.","Me gusta mucho viajar."],["Heute ist es sehr heiß.","Hoy hace mucho calor."]]},{"id":"nl","name":"Neerlandés","native":"Nederlands","aliases":["Holandés","Flamenco"],"family":"Indoeuropea","branch":"Germánica","script":"Latino","speakers":24,"countries":["nl","be","sr","aw","cw","sx"],"phrases":[["Goedemorgen, hoe gaat het?","Buenos días, ¿qué tal?"],["Dank je wel voor je hulp.","Gracias por tu ayuda."],["Waar is het station?","¿Dónde está la estación?"],["Ik reis heel graag.","Me gusta mucho viajar."],["Vandaag is het erg warm.","Hoy hace mucho calor."]]},{"id":"af","name":"Afrikáans","native":"Afrikaans","family":"Indoeuropea","branch":"Germánica","script":"Latino","speakers":7.2,"countries":["za","na"],"phrases":[["Goeie môre, hoe gaan dit?","Buenos días, ¿qué tal?"],["Baie dankie vir die hulp.","Muchas gracias por la ayuda."],["Waar is die treinstasie?","¿Dónde está la estación de tren?"],["Ek hou baie van reis.","Me gusta mucho viajar."]]},{"id":"lb","name":"Luxemburgués","native":"Lëtzebuergesch","family":"Indoeuropea","branch":"Germánica","script":"Latino","speakers":0.3,"countrie