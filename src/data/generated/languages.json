},{"id":"ga","name":"Irlandés","native":"Gaeilge","aliases":["Gaélico irlandés"],"family":"Indoeuropea","branch":"Céltica","script":"Latino","speakers":0.17,"countries":["ie"],"phrases":[["Dia duit, conas atá tú?","Hola, ¿cómo estás?"],["Go raibh míle maith agat.","Mil gracias."],["Fáilte go hÉirinn!","¡Bienvenido a Irlanda!"],["Is breá liom ceol.","Me encanta la música."]]},{"id":"cy","name":"Galés","native":"Cymraeg","family":"Indoeuropea","branch":"Céltica","script":"Latino","speakers":0.56,"countries":["gb-wls"],"phrases":[["Bore da, sut wyt ti?","Buenos días, ¿cómo estás?"],["Diolch yn fawr iawn.","Muchísimas gracias."],["Croeso i Gymru!","¡Bienvenido a Gales!"]]},{"id":"br","name":"Bretón","native":"Brezhoneg","family":"Indoeuropea","branch":"Céltica","script":"Latino","speakers":0.2,"countries":["fr","brittany"],"phrases":[["Demat, mat an traoù?","Hola, ¿qué tal?"],["Trugarez.","Gracias."],["Degemer mat e Breizh!","¡Bienvenido a Bretaña!"]]},{"id":"el","name":"Griego","native":"Ελληνικά","family":"Indoeuropea","branch":"Helénica","script":"Griego","speakers":13,"countries":["gr","cy"],"phrases":[["Καλημέρα, τι κάνεις;","Buenos días, ¿qué tal?"],["Ευχαριστώ πολύ για τη βοήθεια.","Muchas gracias por la ayuda."],["Πού είναι ο σταθμός του τρένου;","¿Dónde está la estación de tren?"],["Μου αρέσει πολύ να ταξιδεύω.","Me gusta mucho viajar."]]},{"id":"sq","name":"Albanés","native":"Shqip","family":"Indoeuropea","branch":"Albanesa","script":"Latino","speakers":7.5,"countries":["al","xk","mk"],"phrases":[["Mirëmëngjes, si je?","Buenos días, ¿cómo estás?"],["Faleminderit shumë për ndihmën.","Muchas gracias por la ayuda."],["Ku është stacioni i trenit?","¿Dónde está la estación de tren?"],["Më pëlqen të udhëtoj.","Me gusta viajar."]]},{"id":"hy","name":"Armenio","native":"Հայերեն","family":"Indoeuropea","branch":"Armenia","script":"Armenio","speakers":5.4,"countries":["am","artsakh"],"phrases":[["Բարի լույս, ինչպե՞ս ես։","Buenos días, ¿cómo estás?"],["Շատ շնորհակալությո